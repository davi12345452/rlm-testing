# Required to run the benchmark live. Not needed for `make replay`, which reproduces the
# published numbers from the committed response cache.
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model overrides. Defaults are the ones used for the committed run.
# The judge is deliberately a different, stronger model than the agents: grading with the model
# under test introduces self-preference bias.
# RLM_AGENT_MODEL=gemini-3.8-flash
# RLM_JUDGE_MODEL=gemini-3.1-pro-preview
# RLM_EMBEDDING_MODEL=gemini-embedding-2
